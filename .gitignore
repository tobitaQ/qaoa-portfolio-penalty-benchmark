# ===== quantum-finance-research 固有 =====

# 実験結果CSV（大容量になりうる、本番置き場はS3）
# ディレクトリ自体ではなく中身を除外する。ディレクトリを除外すると
# git は配下のファイルを再包含できず、下の !パターンが効かなくなるため。
experiments/*/results/*

# ただし論文の表・図の元データになる確定版CSVだけは追跡する。
# 数KBしかない一方、これを追跡しないと Table I と Fig.1〜4 の出典が
# GPU実験機のローカルディスク1台のみに存在することになり、
# 「再現可能な実験基盤」という論文①の主張そのものが担保できない。
!experiments/*/results/paper*.csv
!experiments/*/results/README.md

# Jupyter出力（センシティブなデータや大容量セルを含む可能性）
notebooks/*.ipynb

# CDK合成出力
cdk.out/
cdk/node_modules/

# 論文バイナリ（PDF, Word）。ただし組版済みの成果物そのもの
# （paper01.pdf / paper01_supplement.pdf）は読者が欲しいものなので追跡する。
# コミット済みの .tex から pdflatex 2 パスで決定的に再生成できる。
papers/*.pdf
!papers/paper01.pdf
!papers/paper01_supplement.pdf
papers/*.docx

# AWS認証情報（プロジェクト内に置かない運用だが念のため）
.aws/
aws_credentials*

# ローカル実験ログ
*.log
.DS_Store

# Transient Braket output the SDK drops next to whatever it is run from. Scoped
# to the repository root: `braket_results/` unanchored also matched
# data/braket_results/, which is the opposite of what we want -- that directory
# holds the archived hardware tasks and MUST be tracked. `git add -A` skipped
# them silently, and the copy was lost with the working tree on 2026-08-14.
/braket_results/
!data/braket_results/


# Market-data snapshots (third-party; the package ships data/derived/ instead)
data/prices/
