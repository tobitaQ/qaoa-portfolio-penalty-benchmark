    given-names: Hiroaki
    affiliation: Advanced Institute of Industrial Technology, Tokyo
    email: tobita-hiroaki@aiit.ac.jp
repository-code: https://github.com/tobitaQ/qaoa-portfolio-penalty-benchmark
license: MIT
